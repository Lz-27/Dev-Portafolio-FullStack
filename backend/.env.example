# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Portafolio API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# ─── Seguridad ────────────────────────────────────────────────────────────────
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_MUY_SEGURA_EN_PRODUCCION
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Base de Datos ────────────────────────────────────────────────────────────
# Desarrollo → SQLite (sin configuración extra)
DATABASE_URL=sqlite:///./portafolio.db
# Producción → PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portafolio_db

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Email (para notificaciones de contacto) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
EMAIL_FROM=tu_email@gmail.com
EMAIL_TO=tu_email@gmail.com

# ─── Admin por defecto (seed inicial) ─────────────────────────────────────────
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@portafolio.com
FIRST_ADMIN_PASSWORD=Admin123!CambiaMeEnProduccion
